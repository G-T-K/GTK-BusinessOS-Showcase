# Set these values in your local .env file. Never commit real values.
DATABASE_URL=""

# Direct (non-pooled) connection, needed by some hosts for migrations.
DIRECT_URL=""

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Default base currency for new businesses
DEFAULT_BASE_CURRENCY="USD"

# Required only when running the optional demo seed locally.
SEED_OWNER_PASSWORD=""

# Optional API key for the Business Copilot.
ANTHROPIC_API_KEY=""
